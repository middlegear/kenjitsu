{
  "name": "kenjitsu",
  "version": "0.0.0-development",
  "description": "A lightweight API that serves metadata and video sources from popular streaming sites.",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middlegear/kenjitsu.git"
  },
  "keywords": [
    "anime",
    "movies",
    "tv"
  ],
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/github"
    ]
  },
  "author": "middlegear",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/middlegear/kenjitsu/issues"
  },
  "homepage": "https://github.com/middlegear/kenjitsu#readme",
  "devDependencies": {
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "24.12.4",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@middlegear/kenjitsu-extensions": "latest",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "ioredis": "^5.11.1"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}